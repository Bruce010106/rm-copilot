# Postgres (docker-compose)
POSTGRES_USER=rm
POSTGRES_PASSWORD=rm_dev_password
POSTGRES_DB=rm_copilot
DATABASE_URL=postgresql+psycopg://rm:rm_dev_password@localhost:5432/rm_copilot

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM provider: mock | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint (e.g. DeepSeek / Qwen); leave empty for OpenAI
OPENAI_BASE_URL=
# USD per million tokens; only needed for models missing from the built-in price table.
# Uncomment and fill in the provider's current list price.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# Web -> agent service
AGENT_API_URL=http://localhost:8000
